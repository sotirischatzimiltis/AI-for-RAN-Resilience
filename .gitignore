# Exp 1 (model comparison): keep only the README and the blessed results JSON.
# Timestamped run outputs, logs, and per-episode reasoning/util traces are large and regenerable.
experiments/exp1_model_comparison/*
!experiments/exp1_model_comparison/README.md
!experiments/exp1_model_comparison/model_comparison.json

# Exp 2 (system comparison): keep the README, blessed JSON, plot script, and figure.
# Timestamped run outputs and logs are large and regenerable.
experiments/exp2_system_comparison/*
!experiments/exp2_system_comparison/README.md
!experiments/exp2_system_comparison/system_comparison.json
!experiments/exp2_system_comparison/plot_resilience.py
!experiments/exp2_system_comparison/exp2_system_comparison.pdf
!experiments/exp2_system_comparison/exp2_system_comparison.png

# Exp 5 (compute contention): keep the README, the blessed results JSON, and any plot script.
# Timestamped run outputs and logs are large and regenerable.
experiments/exp5_compute_contention/*
!experiments/exp5_compute_contention/README.md
!experiments/exp5_compute_contention/compute_contention.json
!experiments/exp5_compute_contention/exp5_envelope.json
!experiments/exp5_compute_contention/*.py

# Exp 3 (reserve sizing): keep the README, blessed JSON, plot script, and the 10-seed figures.
